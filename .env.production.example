# Copy to .env.production and replace every placeholder before deployment.
POSTGRES_DB=aastha
POSTGRES_USER=aastha
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://aastha:REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD@db:5432/aastha
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=480
API_CORS_ORIGINS=https://crm.example.com
TRUSTED_HOSTS=crm.example.com,localhost,127.0.0.1
API_DOCS_ENABLED=false
API_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
CRM_HTTP_PORT=8080

# Required only for the first production bootstrap. Use unique strong passwords.
# After successful bootstrap, these can be removed from .env.production; existing users are not reset.
BOOTSTRAP_SUPER_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
BOOTSTRAP_RECEPTION_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
BOOTSTRAP_SUPER_RECEPTION_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
BOOTSTRAP_DOCTOR_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
